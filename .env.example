# LLM Provider configuration (OpenAI-compatible API)
# Default example uses Groq, but can also use OpenAI, Together, OpenRouter, etc.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Backup LLM Provider configuration (Optional)
BACKUP_LLM_BASE_URL=https://api.together.xyz/v1
BACKUP_LLM_API_KEY=your_backup_api_key_here
BACKUP_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ElevenLabs Voice Integration (Tactical Incident Audio & CISO Debrief)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
